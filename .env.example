# Copy this file to .env and adjust whatever you need. .env is in .gitignore.
#
# Config priority, highest to lowest:
#   command-line arguments > .env > config.json > config.py defaults
#
# All of this is optional: config.json already ships with tuned, versioned
# values. Use .env only to deviate from them on your machine.

# --- Credentials -------------------------------------------------------------
# JSON key of the service account with domain-wide delegation.
CREDENTIALS_FILE=client_secret.json

# --- Paths ---------------------------------------------------------------
# Root of all downloaded data.
OUTPUT_DIR=output
LOG_DIR=logs

# --- Rate against the Gmail API -------------------------------------------
# batch_size x max_workers is the number that matters: Gmail limits
# CONCURRENT requests per user, separately from the per-second quota. 25 x 2
# sustains ~37-42 msg/s with no failures; 100 x 5 causes mass 429s. On 429s,
# lower MAX_WORKERS first. Detail in docs/CONFIG.md.
BATCH_SIZE=25
PAYLOAD_BATCH_SIZE=20
MAX_WORKERS=2
MESSAGES_PER_SECOND=40

# --- Retries -----------------------------------------------------------------
# Only transient failures are retried (429, 5xx, 403-by-quota).
RETRY_ATTEMPTS=8
RETRY_WAIT_MIN=4
RETRY_WAIT_MAX=64
